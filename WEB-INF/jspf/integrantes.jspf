<%-- Estudiantes de un proyecto en una lista simple: iniciales, nombre, contacto, datos
     académicos y créditos. Antes de incluirlo, definir:
       idProyectoIntegrantes  el proyecto
       integrantesDetalle     true para el director y el comité (datos académicos y
                              celular, RF19); false para el estudiante, que de sus
                              compañeros solo ve el nombre y el correo. --%>
<sql:query var="consultaIntegrantes">
    SELECT u.nombre, u.correo, u.celular, u.carrera, n.nombre AS nivel, u.plan_estudios, u.porcentaje_creditos
    FROM proyecto_estudiantes pe
    JOIN usuarios u ON u.id = pe.estudiante_id
    LEFT JOIN niveles n ON n.id = u.nivel_id
    WHERE pe.proyecto_id = ? AND pe.vigente = 1 ORDER BY u.nombre
    <sql:param value="${idProyectoIntegrantes}" />
</sql:query>
<ul class="app-personas">
    <c:forEach var="i" items="${consultaIntegrantes.rows}">
        <c:set var="partesNombre" value="${fn:split(fn:trim(i.nombre), ' ')}" />
        <li>
            <span class="app-iniciales" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(partesNombre[0], 0, 1))}${fn:length(partesNombre) > 1 ? fn:toUpperCase(fn:substring(partesNombre[1], 0, 1)) : ''}" /></span>
            <span>
                <span class="app-personas-nombre"><c:out value="${i.nombre}" /></span>
                <span class="app-personas-linea">
                    <a href="mailto:${fn:escapeXml(i.correo)}"><c:out value="${i.correo}" /></a><c:if test="${integrantesDetalle and not empty i.celular}"> · <c:out value="${i.celular}" /></c:if>
                </span>
                <c:if test="${integrantesDetalle}">
                    <span class="app-personas-linea">
                        <c:if test="${not empty i.carrera}"><c:out value="${i.carrera}" /> · </c:if><c:if test="${not empty i.nivel}"><c:out value="${i.nivel}" /> · </c:if>plan <c:out value="${empty i.plan_estudios ? 'sin registrar' : fn:toLowerCase(i.plan_estudios)}" />
                    </span>
                    <c:if test="${not empty i.porcentaje_creditos}">
                        <span class="app-creditos">
                            <span class="app-creditos-pista" role="progressbar" aria-label="Créditos aprobados" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${i.porcentaje_creditos}">
                                <span class="app-creditos-barra d-block" style="width: ${i.porcentaje_creditos}%"></span>
                            </span>
                            <span><c:out value="${i.porcentaje_creditos}" /> % de créditos</span>
                        </span>
                    </c:if>
                </c:if>
            </span>
        </li>
    </c:forEach>
</ul>
