<%-- Estudiantes de un proyecto: cada uno en una línea con su foto y su nombre; "Ver
     estudiante" abre sus datos como pares etiqueta / valor, con el estado del pago de
     cada uno (cada estudiante paga el suyo, RF32). Antes de incluirlo, definir:
       idProyectoIntegrantes  el proyecto
       integrantesDetalle     true para el director y el comité (datos académicos y
                              celular, RF19); false para el estudiante, que de sus
                              compañeros solo ve el nombre, el correo y el pago.
       integrantesSalir       true para mostrar el botón "Salirme del proyecto" en los
                              datos de uno mismo, si no es el único; lo usa "Mi proyecto"
                              en las fases 1 y 2. Nadie quita a otro (RF36, decisión del
                              2026-10-19). --%>
<%@ include file="/WEB-INF/jspf/estado-pago.jspf" %>
<sql:query var="consultaIntegrantes">
    SELECT ue.id, ue.nombre, ue.correo, ue.celular, ca.nombre AS carrera, ca.campus, n.nombre AS nivel, ue.plan_estudios, ue.porcentaje_creditos,
           ${sqlEstadoPagoEstudiante} AS pago
    FROM proyecto_estudiantes pe
    JOIN proyectos p ON p.id = pe.proyecto_id
    JOIN usuarios ue ON ue.id = pe.estudiante_id
    LEFT JOIN niveles n ON n.id = ue.nivel_id
    LEFT JOIN carreras ca ON ca.id = ue.carrera_id
    WHERE pe.proyecto_id = ? AND pe.vigente = 1 ORDER BY ue.nombre
    <sql:param value="${idProyectoIntegrantes}" />
</sql:query>
<c:forEach var="i" items="${consultaIntegrantes.rows}">
    <c:set var="idIntegrante">${i.id}</c:set>
    <c:set var="idSesion">${sessionScope.usuario.id}</c:set>
    <%-- Plegado: se ve el nombre; "Ver estudiante" abre sus datos (pedido del equipo, 2026-10-19) --%>
    <details class="app-estudiante">
        <summary class="app-estudiante-nombre">
            <img class="app-iniciales" src="${ctx}/img/perfil.png" alt="" width="40" height="40">
            <span><c:out value="${i.nombre}" />${idIntegrante == idSesion ? ' (tú)' : ''}</span>
            <span class="btn btn-sm btn-outline-dark rounded-pill app-ver-estudiante"><span class="ver">Ver estudiante</span><span class="ocultar">Ocultar</span></span>
        </summary>
        <dl class="app-pares">
            <div class="ancho"><dt>Correo</dt><dd><a href="mailto:${fn:escapeXml(i.correo)}"><c:out value="${i.correo}" /></a></dd></div>
            <c:if test="${integrantesDetalle}">
                <div><dt>Celular</dt><dd><c:out value="${empty i.celular ? 'Sin registrar' : i.celular}" /></dd></div>
                <div><dt>Nivel</dt><dd><c:out value="${empty i.nivel ? 'Sin registrar' : i.nivel}" /></dd></div>
                <div class="ancho"><dt>Carrera</dt><dd><c:out value="${empty i.carrera ? 'Sin registrar' : i.carrera}" /><c:if test="${not empty i.campus}"> · <c:out value="${i.campus}" /></c:if></dd></div>
                <div><dt>Plan de estudios</dt><dd><c:out value="${empty i.plan_estudios ? 'Sin registrar' : (i.plan_estudios == 'Nuevo' ? 'Posterior al 1330' : 'Anterior al 1330')}" /></dd></div>
                <div><dt>Créditos aprobados</dt><dd><c:out value="${empty i.porcentaje_creditos ? 'Sin registrar' : i.porcentaje_creditos}" /><c:if test="${not empty i.porcentaje_creditos}"> %</c:if></dd></div>
            </c:if>
            <div><dt>Pago</dt><dd><c:out value="${i.pago == 'No aplica' ? 'No aplica (lo cubre la matrícula)' : i.pago}" /></dd></div>
        </dl>
        <c:if test="${integrantesSalir and idIntegrante == idSesion and consultaIntegrantes.rowCount > 1}">
            <form class="mt-3" method="post" action="${ctx}/estudiante/integrante-salir.jsp"
                  onsubmit="return confirm('¿Salirte del proyecto? Tus compañeros siguen con él y tú podrás tomar otra idea.');">
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Salirme del proyecto</button>
            </form>
        </c:if>
    </details>
</c:forEach>
