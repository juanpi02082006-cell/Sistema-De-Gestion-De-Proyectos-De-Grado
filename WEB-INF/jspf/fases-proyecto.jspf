<%-- Tarjetas con las fases del proyecto (RF2, RF37), como el seguimiento del sistema
     actual de la UTS: las fases pasadas en lima con un chulo, la actual en lima suave
     con un reloj de arena y las que faltan en blanco. Antes de incluirlo, definir
     faseActual (el número de la fase, fases.orden) y estadoProyecto (proyectos.estado).
     Si el proyecto terminó antes de la fase final (todos los integrantes exonerados por
     Saber TyT, RNF14), su fase queda completa y las que siguen dicen que no aplican; si
     terminó en la fase final (aprobación final del comité, RF39), todas quedan completas;
     si se canceló, la fase en que quedó lo dice. En Seminario (esSeminario = true), que no usa
     el F-DC-124 ni las fases de la propuesta, muestra sus tres pasos según el estado del
     proyecto: inscripción, seminario en curso y nota final.
     Contador de la fase 4 (RF2, A-15): si se define idProyectoFases y el proyecto está en
     la fase 4, su tarjeta dice el día del informe final ("Día N de 180", con las prórrogas
     aprobadas el plazo crece) y cuánto falta para enviarlo (día 90) o para la fecha límite;
     antes de que el comité apruebe la propuesta, cuántos días lleva en la fase (desde que
     el director la aprobó). --%>
<c:choose>
<c:when test="${esSeminario}">
    <c:set var="pasoSeminario" value="${estadoProyecto == 'Pendiente' ? 1 : (estadoProyecto == 'En curso' ? 2 : (estadoProyecto == 'Finalizado' ? 4 : 0))}" />
    <div class="app-fases">
        <c:forEach var="paso" begin="1" end="3">
            <c:set var="estadoFase" value="${paso < pasoSeminario ? 'completa' : (paso == pasoSeminario ? 'actual' : 'pendiente')}" />
            <div class="app-fase ${estadoFase}">
                <span class="app-fase-icono" aria-hidden="true">
                    <c:choose>
                        <c:when test="${estadoFase == 'completa'}"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></c:when>
                        <c:when test="${estadoFase == 'actual'}"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 3h12M6 21h12"/><path d="M7 3c0 5 10 5 10 9s-10 4-10 9"/><path d="M17 3c0 5-10 5-10 9s10 4 10 9"/></svg></c:when>
                        <c:otherwise><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg></c:otherwise>
                    </c:choose>
                </span>
                <span class="app-fase-nombre">Paso ${paso}: ${paso == 1 ? 'Inscripción' : (paso == 2 ? 'Seminario en curso' : 'Nota final')}</span>
                <span class="app-fase-texto">${paso == 1 ? 'Recibo de pago, formato F-AM-04 y cédula; el comité valida la inscripción' : (paso == 2 ? 'Clases y entregable con el docente del seminario (en Atena)' : 'El docente registra la nota; aprobada, el requisito queda cumplido')}</span>
                <span class="visually-hidden">${estadoFase == 'completa' ? '(completado)' : (estadoFase == 'actual' ? '(paso actual)' : '(pendiente)')}</span>
            </div>
        </c:forEach>
    </div>
</c:when>
<c:otherwise>
<sql:query var="fasesTodas">SELECT orden, nombre, descripcion FROM fases ORDER BY orden</sql:query>
<c:set var="proyectoTerminado" value="${estadoProyecto == 'Finalizado'}" />
<c:set var="proyectoCancelado" value="${estadoProyecto == 'Cancelado'}" />
<c:set var="hayContadorFase4" value="false" />
<c:if test="${not empty idProyectoFases and faseActual == 4 and not proyectoTerminado and not proyectoCancelado}">
    <sql:query var="consultaContador">
        SELECT (p.fecha_aprobacion_124 IS NOT NULL) AS aprobada,
               DATEDIFF(CURDATE(), p.fecha_aprobacion_124) AS dia,
               DATEDIFF(p.fecha_limite, p.fecha_aprobacion_124) AS plazo,
               DATEDIFF(p.fecha_aprobacion_124 + INTERVAL 90 DAY, CURDATE()) AS faltan_envio,
               DATEDIFF(p.fecha_limite, CURDATE()) AS faltan_limite,
               DATEDIFF(CURDATE(), (SELECT MAX(r.revisado_en) FROM revisiones r JOIN entregas e ON e.id = r.entrega_id
                                    WHERE e.proyecto_id = p.id AND e.tipo = 'FDC-124' AND r.rol = 'Director'
                                      AND r.estado = 'Enviada' AND r.decision = 'Aprobado')) AS dias_en_fase
        FROM proyectos p WHERE p.id = ?
        <sql:param value="${idProyectoFases}" />
    </sql:query>
    <c:if test="${consultaContador.rowCount > 0}">
        <c:set var="contador" value="${consultaContador.rows[0]}" />
        <c:set var="hayContadorFase4" value="${contador.aprobada == 1 or not empty contador.dias_en_fase}" />
    </c:if>
</c:if>
<div class="app-fases">
    <c:forEach var="f" items="${fasesTodas.rows}">
        <c:set var="estadoFase" value="${proyectoTerminado or f.orden < faseActual ? 'completa' : (f.orden == faseActual ? (proyectoCancelado ? 'cancelada' : 'actual') : 'pendiente')}" />
        <div class="app-fase ${estadoFase}">
            <span class="app-fase-icono" aria-hidden="true">
                <c:choose>
                    <c:when test="${estadoFase == 'completa'}"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></c:when>
                    <c:when test="${estadoFase == 'cancelada'}"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/></svg></c:when>
                    <c:when test="${estadoFase == 'actual'}"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 3h12M6 21h12"/><path d="M7 3c0 5 10 5 10 9s-10 4-10 9"/><path d="M17 3c0 5-10 5-10 9s10 4 10 9"/></svg></c:when>
                    <c:when test="${f.orden == 6}"><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg></c:when>
                    <c:otherwise><svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg></c:otherwise>
                </c:choose>
            </span>
            <span class="app-fase-nombre"><c:choose><c:when test="${f.orden == 6}">Fase final</c:when><c:otherwise>Fase ${f.orden}</c:otherwise></c:choose>: <c:out value="${f.nombre}" /></span>
            <span class="app-fase-texto">
                <c:choose>
                    <c:when test="${proyectoTerminado and f.orden == faseActual and faseActual < 6}">Propuesta aprobada; el informe final quedó exonerado por Saber TyT</c:when>
                    <c:when test="${proyectoTerminado and f.orden > faseActual}">No aplica: exonerado por Saber TyT</c:when>
                    <c:when test="${proyectoTerminado and f.orden == 6}">Sustentación hecha y aprobación final del comité: proyecto finalizado</c:when>
                    <c:when test="${estadoFase == 'cancelada'}">El proyecto se canceló en esta fase</c:when>
                    <c:otherwise><c:out value="${f.descripcion}" /></c:otherwise>
                </c:choose>
            </span>
            <c:if test="${f.orden == 4 and estadoFase == 'actual' and hayContadorFase4}">
                <c:choose>
                    <c:when test="${contador.aprobada == 1}">
                        <span class="app-fase-contador">Día <c:out value="${contador.dia}" /> de <c:out value="${contador.plazo}" /> del informe final</span>
                        <span class="app-fase-texto">
                            <c:choose>
                                <c:when test="${contador.dia < 90}">Se envía desde el día 90: faltan <c:out value="${contador.faltan_envio}" /> ${contador.faltan_envio == 1 ? 'día' : 'días'}.</c:when>
                                <c:when test="${contador.faltan_limite >= 0}">Faltan <c:out value="${contador.faltan_limite}" /> ${contador.faltan_limite == 1 ? 'día' : 'días'} para la fecha límite.</c:when>
                                <c:otherwise>Se venció la fecha límite.</c:otherwise>
                            </c:choose>
                        </span>
                    </c:when>
                    <c:otherwise>
                        <span class="app-fase-contador">${contador.dias_en_fase == 0 ? 'Desde hoy' : 'Lleva '}<c:if test="${contador.dias_en_fase > 0}"><c:out value="${contador.dias_en_fase}" /> ${contador.dias_en_fase == 1 ? 'día' : 'días'}</c:if> en esta fase</span>
                        <span class="app-fase-texto">El evaluador y el comité revisan la propuesta.</span>
                    </c:otherwise>
                </c:choose>
            </c:if>
            <span class="visually-hidden">${estadoFase == 'completa' ? '(completada)' : (estadoFase == 'actual' ? '(fase actual)' : (estadoFase == 'cancelada' ? '(cancelada)' : '(pendiente)'))}</span>
        </div>
    </c:forEach>
</div>
</c:otherwise>
</c:choose>
