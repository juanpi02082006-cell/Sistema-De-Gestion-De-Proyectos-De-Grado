<%-- Tarjeta "Datos del proyecto": la descripción y los datos como pares etiqueta / valor.
     Antes de incluirlo, definir p (la fila del proyecto). Usa las columnas que tenga:
     descripcion, codigo, estado, modalidad, nivel, periodo, fecha_inicio,
     fecha_limite_propuestas y director; las que falten no se muestran. El director solo
     sale si se define datosConDirector = true (sale "Por asignar" si no tiene).
     datosTitulo cambia el título de la tarjeta (por defecto "Datos del proyecto"). --%>
<h2 class="app-tarjeta-titulo"><c:out value="${empty datosTitulo ? 'Datos del proyecto' : datosTitulo}" /></h2>
<c:if test="${not empty p.descripcion}"><p class="app-texto-proyecto"><c:out value="${p.descripcion}" /></p></c:if>
<dl class="app-pares">
    <div><dt>Código</dt><dd><c:out value="${empty p.codigo ? 'Sin asignar' : p.codigo}" /></dd></div>
    <div><dt>Estado</dt><dd><c:out value="${p.estado}" /></dd></div>
    <c:if test="${not empty p.modalidad}"><div><dt>Modalidad</dt><dd><c:out value="${p.modalidad}" /></dd></div></c:if>
    <c:if test="${not empty p.nivel}"><div><dt>Nivel</dt><dd><c:out value="${p.nivel}" /></dd></div></c:if>
    <c:if test="${not empty p.periodo}"><div><dt>Periodo</dt><dd><c:out value="${p.periodo}" /></dd></div></c:if>
    <c:if test="${datosConDirector}"><div><dt>Director</dt><dd><c:out value="${empty p.director ? 'Por asignar' : p.director}" /></dd></div></c:if>
    <c:if test="${not empty p.fecha_inicio}"><div><dt>Inicio</dt><dd><fmt:formatDate value="${p.fecha_inicio}" pattern="dd/MM/yyyy" /></dd></div></c:if>
    <c:if test="${not empty p.fecha_limite_propuestas}"><div><dt>Límite de la propuesta</dt><dd><fmt:formatDate value="${p.fecha_limite_propuestas}" pattern="dd/MM/yyyy" /></dd></div></c:if>
</dl>
