<%-- Alertas de vencimiento del usuario de la sesión (RF5, RNF21): no hay un proceso
     programado, así que se revisan cada vez que la persona usa el sistema (lo incluye
     cabecera.jspf). Cada alerta lleva una clave y se inserta con INSERT IGNORE, así
     que no se repite. Alertas:
       - límite de pago a 10 y a 5 días, para el estudiante sin el pago aprobado (RF32);
       - semana 12 (propuesta aprobada a tiempo) a 10 y a 5 días, para los estudiantes y
         el director de los proyectos en las fases 1 a 3 con algún estudiante de plan
         anterior (RF30); al vencer, el proyecto se cancela (cierres.jspf);
       - plazo del director para revisar la propuesta, al vencer (RF21);
       - plazo del evaluador para evaluarla (3 días hábiles), al vencer (RF21);
       - informe final (fase 5): plazo del director para revisarlo y del evaluador para
         evaluarlo (5 días hábiles cada uno), al vencer (RF21);
       - límite del informe final (180 días desde la aprobación del FDC-124) a 30, 10 y
         5 días, para los estudiantes y el director de los proyectos en la fase 4 (RF5). --%>
<%@ include file="/WEB-INF/jspf/estado-pago.jspf" %>
<c:set var="idAlerta" value="${sessionScope.usuario.id}" />
<c:forEach var="diasAlerta" items="10,5">
    <%-- Pago --%>
    <sql:update>
        INSERT IGNORE INTO avisos (usuario_id, proyecto_id, mensaje, enlace, clave)
        SELECT ue.id, p.id,
               CONCAT('Faltan ', DATEDIFF(pr.fecha_limite_pago, CURDATE()), ' días para el límite de pago (',
                      DATE_FORMAT(pr.fecha_limite_pago, '%d/%m/%Y'), ') y tu pago todavía no está aprobado.'),
               '/estudiante/proyecto.jsp', CONCAT('pago-', ?, '-p', p.id)
        FROM proyecto_estudiantes pe
        JOIN proyectos p ON p.id = pe.proyecto_id
        JOIN usuarios ue ON ue.id = pe.estudiante_id
        JOIN fases f ON f.id = p.fase_id
        JOIN periodos pr ON pr.id = p.periodo_id
        WHERE pe.estudiante_id = ? AND pe.vigente = 1 AND f.orden IN (1, 2)
          AND p.estado NOT IN ('Finalizado', 'Cancelado')
          AND DATEDIFF(pr.fecha_limite_pago, CURDATE()) BETWEEN 0 AND ?
          AND ${sqlEstadoPagoEstudiante} NOT IN ('Aprobado', 'No aplica')
        <sql:param value="${diasAlerta}" />
        <sql:param value="${idAlerta}" />
        <sql:param value="${diasAlerta}" />
    </sql:update>
    <%-- Semana 12: estudiantes y director --%>
    <sql:update>
        INSERT IGNORE INTO avisos (usuario_id, proyecto_id, mensaje, enlace, clave)
        SELECT ?, p.id,
               CONCAT('Faltan ', DATEDIFF(pr.fecha_limite_propuestas, CURDATE()), ' días para que la propuesta de «',
                      LEFT(p.titulo, 80), '» quede aprobada (límite: ', DATE_FORMAT(pr.fecha_limite_propuestas, '%d/%m/%Y'), ').'),
               CASE WHEN p.director_id = ? THEN CONCAT('/director/proyecto.jsp?id=', p.id) ELSE '/estudiante/proyecto.jsp' END,
               CONCAT('semana12-', ?, '-p', p.id)
        FROM proyectos p
        JOIN fases f ON f.id = p.fase_id
        JOIN periodos pr ON pr.id = p.periodo_id
        WHERE f.orden IN (1, 2, 3) AND p.estado NOT IN ('Finalizado', 'Cancelado') AND p.modalidad_id <> 5
          AND DATEDIFF(pr.fecha_limite_propuestas, CURDATE()) BETWEEN 0 AND ?
          AND (p.director_id = ? OR EXISTS (SELECT 1 FROM proyecto_estudiantes x
                                            WHERE x.proyecto_id = p.id AND x.vigente = 1 AND x.estudiante_id = ?))
          AND EXISTS (SELECT 1 FROM proyecto_estudiantes y JOIN usuarios uy ON uy.id = y.estudiante_id
                      WHERE y.proyecto_id = p.id AND y.vigente = 1 AND (uy.plan_estudios IS NULL OR uy.plan_estudios <> 'Nuevo'))
        <sql:param value="${idAlerta}" />
        <sql:param value="${idAlerta}" />
        <sql:param value="${diasAlerta}" />
        <sql:param value="${diasAlerta}" />
        <sql:param value="${idAlerta}" />
        <sql:param value="${idAlerta}" />
    </sql:update>
</c:forEach>
<%-- Plazo del director para revisar la propuesta (fase 3), vencido --%>
<sql:update>
    INSERT IGNORE INTO avisos (usuario_id, proyecto_id, mensaje, enlace, clave)
    SELECT p.director_id, p.id,
           CONCAT('Se venció el plazo para revisar la propuesta de «', LEFT(p.titulo, 80), '» (',
                  DATE_FORMAT(e.fecha_limite_revision, '%d/%m/%Y'), ').'),
           CONCAT('/director/proyecto.jsp?id=', p.id), CONCAT('revision-e', e.id)
    FROM proyectos p
    JOIN fases f ON f.id = p.fase_id AND f.orden = 3
    JOIN entregas e ON e.proyecto_id = p.id AND e.tipo = 'FDC-124'
         AND e.version = (SELECT MAX(e2.version) FROM entregas e2 WHERE e2.proyecto_id = p.id AND e2.tipo = 'FDC-124')
    WHERE p.director_id = ? AND p.estado NOT IN ('Finalizado', 'Cancelado')
      AND e.fecha_limite_revision < CURDATE()
    <sql:param value="${idAlerta}" />
</sql:update>
<%-- Plazo del evaluador para evaluar la propuesta (fase 4, el director ya se la envió), vencido --%>
<%@ include file="/WEB-INF/jspf/revision-propuesta.jspf" %>
<sql:update>
    INSERT IGNORE INTO avisos (usuario_id, proyecto_id, mensaje, enlace, clave)
    SELECT p.evaluador_id, p.id,
           CONCAT('Se venció el plazo para evaluar la propuesta de «', LEFT(p.titulo, 80), '» (',
                  DATE_FORMAT(e.fecha_limite_revision, '%d/%m/%Y'), ').'),
           CONCAT('/evaluador/proyecto.jsp?id=', p.id), CONCAT('evaluacion-e', e.id, '-', e.fecha_limite_revision)
    FROM proyectos p
    JOIN fases f ON f.id = p.fase_id AND f.orden = 4
    JOIN entregas e ON e.proyecto_id = p.id AND e.tipo = 'FDC-124'
         AND e.version = (SELECT MAX(e2.version) FROM entregas e2 WHERE e2.proyecto_id = p.id AND e2.tipo = 'FDC-124')
    WHERE p.evaluador_id = ? AND p.estado NOT IN ('Finalizado', 'Cancelado')
      AND e.fecha_limite_revision < CURDATE() AND ${sqlUltimaRevision} = 'Director:Aprobado'
    <sql:param value="${idAlerta}" />
</sql:update>
<%-- Informe final (fase 5): plazo del director para revisarlo y del evaluador para evaluarlo, vencidos --%>
<sql:update>
    INSERT IGNORE INTO avisos (usuario_id, proyecto_id, mensaje, enlace, clave)
    SELECT CASE WHEN ${sqlUltimaRevisionInforme} = 'Director:Aprobado' THEN p.evaluador_id ELSE p.director_id END, p.id,
           CONCAT('Se venció el plazo para ', CASE WHEN ${sqlUltimaRevisionInforme} = 'Director:Aprobado' THEN 'evaluar' ELSE 'revisar' END,
                  ' el informe final de «', LEFT(p.titulo, 80), '» (', DATE_FORMAT(e.fecha_limite_revision, '%d/%m/%Y'), ').'),
           CASE WHEN ${sqlUltimaRevisionInforme} = 'Director:Aprobado' THEN CONCAT('/evaluador/proyecto.jsp?id=', p.id)
                ELSE CONCAT('/director/proyecto.jsp?id=', p.id) END,
           CONCAT('informe-e', e.id, '-', e.fecha_limite_revision)
    FROM proyectos p
    JOIN fases f ON f.id = p.fase_id AND f.orden = 5
    JOIN entregas e ON e.proyecto_id = p.id AND e.tipo = 'FDC-125'
         AND e.version = (SELECT MAX(e2.version) FROM entregas e2 WHERE e2.proyecto_id = p.id AND e2.tipo = 'FDC-125')
    WHERE p.estado NOT IN ('Finalizado', 'Cancelado') AND e.fecha_limite_revision < CURDATE()
      AND ((COALESCE(${sqlUltimaRevisionInforme}, 'Comité:Devuelto') = 'Comité:Devuelto' AND p.director_id = ?)
           OR (${sqlUltimaRevisionInforme} = 'Director:Aprobado' AND p.evaluador_id = ?))
    <sql:param value="${idAlerta}" />
    <sql:param value="${idAlerta}" />
</sql:update>
<%-- Límite del informe final a 30, 10 y 5 días: estudiantes y director --%>
<c:forEach var="diasInforme" items="30,10,5">
    <sql:update>
        INSERT IGNORE INTO avisos (usuario_id, proyecto_id, mensaje, enlace, clave)
        SELECT ?, p.id,
               CONCAT('Faltan ', DATEDIFF(p.fecha_limite, CURDATE()), ' días para el límite del informe final de «',
                      LEFT(p.titulo, 80), '» (', DATE_FORMAT(p.fecha_limite, '%d/%m/%Y'),
                      '). Si no alcanza, pidan una prórroga antes de esa fecha.'),
               CASE WHEN p.director_id = ? THEN CONCAT('/director/proyecto.jsp?id=', p.id) ELSE '/estudiante/proyecto.jsp' END,
               CONCAT('informe-', ?, '-p', p.id, '-', p.fecha_limite)
        FROM proyectos p
        JOIN fases f ON f.id = p.fase_id
        WHERE f.orden = 4 AND p.estado NOT IN ('Finalizado', 'Cancelado') AND p.fecha_limite IS NOT NULL
          AND DATEDIFF(p.fecha_limite, CURDATE()) BETWEEN 0 AND ?
          AND (p.director_id = ? OR EXISTS (SELECT 1 FROM proyecto_estudiantes x
                                            WHERE x.proyecto_id = p.id AND x.vigente = 1 AND x.estudiante_id = ?))
        <sql:param value="${idAlerta}" />
        <sql:param value="${idAlerta}" />
        <sql:param value="${diasInforme}" />
        <sql:param value="${diasInforme}" />
        <sql:param value="${idAlerta}" />
        <sql:param value="${idAlerta}" />
    </sql:update>
</c:forEach>
