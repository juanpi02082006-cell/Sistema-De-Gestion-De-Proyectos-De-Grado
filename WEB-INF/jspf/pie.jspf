<%-- Cierre de las páginas internas, con el botón que abre el menú lateral en celular. --%>
        </main>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.1.0/js/bootstrap.bundle.min.js"></script>
<script>
    // En pantallas pequeñas el menú lateral se abre y se cierra con el botón de la cabecera
    (function () {
        var boton = document.getElementById('botonMenu');
        var velo = document.getElementById('veloMenu');
        if (!boton || !velo) { return; }
        function abrir(si) {
            document.body.classList.toggle('menu-abierto', si);
            boton.setAttribute('aria-expanded', si ? 'true' : 'false');
            velo.hidden = !si;
        }
        boton.addEventListener('click', function () { abrir(!document.body.classList.contains('menu-abierto')); });
        velo.addEventListener('click', function () { abrir(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { abrir(false); } });
    })();
</script>
</body>
</html>
