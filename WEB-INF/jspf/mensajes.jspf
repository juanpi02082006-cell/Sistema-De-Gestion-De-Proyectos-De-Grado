<%-- Avisos de éxito (?ok=...) y de error (?error=...) de las páginas internas. --%>
<c:if test="${not empty param.ok}">
    <div class="alert alert-success app-aviso" role="status">
        <c:choose>
            <c:when test="${param.ok == 'usuario-creado'}">El usuario se creó correctamente.</c:when>
            <c:when test="${param.ok == 'usuario-actualizado'}">Los cambios del usuario se guardaron.</c:when>
            <c:when test="${param.ok == 'usuario-eliminado'}">El usuario se eliminó.</c:when>
            <c:when test="${param.ok == 'rol-creado'}">El rol se creó correctamente.</c:when>
            <c:when test="${param.ok == 'rol-actualizado'}">Los cambios del rol se guardaron.</c:when>
            <c:when test="${param.ok == 'rol-eliminado'}">El rol se eliminó.</c:when>
            <c:when test="${param.ok == 'periodo-creado'}">El periodo se creó. Queda como "Planeado" hasta que lo actives.</c:when>
            <c:when test="${param.ok == 'periodo-actualizado'}">Los cambios del periodo se guardaron.</c:when>
            <c:when test="${param.ok == 'periodo-eliminado'}">El periodo se eliminó.</c:when>
            <c:when test="${param.ok == 'periodo-activado'}">El periodo quedó activo: su calendario es el vigente.</c:when>
            <c:when test="${param.ok == 'periodo-cerrado'}">El periodo quedó cerrado.</c:when>
            <c:when test="${param.ok == 'modalidad-actualizada'}">Los cambios de la modalidad se guardaron.</c:when>
            <c:when test="${param.ok == 'idea-creada'}">La idea se registró. Queda pendiente hasta que el comité la revise.</c:when>
            <c:when test="${param.ok == 'idea-actualizada'}">Los cambios de la idea se guardaron. Vuelve a quedar pendiente de revisión.</c:when>
            <c:when test="${param.ok == 'idea-eliminada'}">La idea se eliminó.</c:when>
            <c:when test="${param.ok == 'idea-aprobada'}">La idea quedó aprobada y disponible en el banco.</c:when>
            <c:when test="${param.ok == 'idea-rechazada'}">La idea quedó rechazada.</c:when>
            <c:when test="${param.ok == 'idea-tomada'}">Tomaste la idea: tu proyecto quedó creado en la fase 1.</c:when>
            <c:when test="${param.ok == 'pago-subido'}">El recibo de pago se subió correctamente. Queda en revisión del comité.</c:when>
            <c:when test="${param.ok == 'pago-aprobado'}">El pago quedó aprobado. El proyecto pasa a la fase 2 cuando tenga director.</c:when>
            <c:when test="${param.ok == 'pago-aprobado-fase-2'}">El pago quedó aprobado y el proyecto pasó a la fase 2 (Propuesta I).</c:when>
            <c:when test="${param.ok == 'pago-devuelto'}">El recibo se devolvió al estudiante con la observación.</c:when>
            <c:when test="${param.ok == 'asignacion-guardada'}">El director y el evaluador quedaron guardados.</c:when>
            <c:when test="${param.ok == 'propuesta-subida'}">La versión del FDC-124 se subió correctamente. Cuando esté lista, envíasela a tu director.</c:when>
            <c:when test="${param.ok == 'propuesta-enviada'}">Enviaste la propuesta a tu director: el proyecto pasó a la fase 3 (Propuesta II).</c:when>
            <c:when test="${param.ok == 'propuesta-devuelta-director'}">Devolviste la propuesta al estudiante con tus observaciones: el proyecto volvió a la fase 2.</c:when>
            <c:when test="${param.ok == 'propuesta-aprobada-director'}">Aprobaste la propuesta y la enviaste al evaluador y al comité: el proyecto pasó a la fase 4.</c:when>
            <c:when test="${param.ok == 'integrante-agregado'}">Tu compañero quedó en el proyecto. Recuerda que cada uno sube su propio recibo de pago.</c:when>
            <c:when test="${param.ok == 'integrante-quitado'}">El compañero salió del proyecto.</c:when>
            <c:when test="${param.ok == 'observacion-codirector'}">Tu observación quedó en la versión. El director la ve antes de decidir.</c:when>
            <c:when test="${param.ok == 'anexo-subido'}">El anexo se subió correctamente.</c:when>
            <c:when test="${param.ok == 'anexo-quitado'}">El anexo se quitó.</c:when>
            <c:when test="${param.ok == 'modalidad-solicitada'}">Tu solicitud de cambio de modalidad quedó enviada al comité.</c:when>
            <c:when test="${param.ok == 'modalidad-aprobada'}">El cambio de modalidad quedó aprobado.</c:when>
            <c:when test="${param.ok == 'modalidad-rechazada'}">El cambio de modalidad quedó rechazado.</c:when>
            <c:when test="${param.ok == 'exoneracion-solicitada'}">Tu solicitud de exoneración quedó enviada: el comité verificará el certificado.</c:when>
            <c:when test="${param.ok == 'exoneracion-renunciada'}">Renunciaste a la exoneración: sigues con el proyecto.</c:when>
            <c:when test="${param.ok == 'exoneracion-aprobada'}">La exoneración quedó aprobada.</c:when>
            <c:when test="${param.ok == 'exoneracion-rechazada'}">La exoneración quedó rechazada.</c:when>
            <c:when test="${param.ok == 'exoneracion-proyecto-terminado'}">La exoneración quedó aprobada y, como todos los integrantes están exonerados, el proyecto terminó con concepto Aprobado.</c:when>
            <c:when test="${param.ok == 'pqr-enviada'}">Tu PQR quedó enviada al comité. Te llega un aviso cuando la respondan.</c:when>
            <c:when test="${param.ok == 'pqr-respondida'}">La respuesta quedó enviada.</c:when>
            <c:when test="${param.ok == 'asignacion-fase-2'}">El director quedó asignado y el proyecto pasó a la fase 2 (Propuesta I).</c:when>
            <c:when test="${param.ok == 'sesion-creada'}">La sesión del comité quedó en el calendario.</c:when>
            <c:when test="${param.ok == 'sesion-eliminada'}">La sesión se quitó del calendario.</c:when>
            <c:otherwise>Listo.</c:otherwise>
        </c:choose>
    </div>
</c:if>
<c:if test="${not empty param.error}">
    <div class="alert alert-danger app-aviso" role="alert">
        <c:choose>
            <c:when test="${param.error == 'denegado'}">No tienes permiso para entrar a esa página.</c:when>
            <c:when test="${param.error == 'eliminar-propio'}">No puedes eliminar tu propio usuario.</c:when>
            <c:when test="${param.error == 'usuario-con-registros'}">No se puede eliminar el usuario porque tiene información asociada (proyectos, ideas, entregas…). Puedes desactivarlo desde "Editar".</c:when>
            <c:when test="${param.error == 'rol-base'}">Los roles base del sistema no se pueden eliminar.</c:when>
            <c:when test="${param.error == 'rol-con-usuarios'}">No se puede eliminar el rol porque tiene usuarios asignados.</c:when>
            <c:when test="${param.error == 'no-encontrado'}">El registro que buscas no existe.</c:when>
            <c:when test="${param.error == 'periodo-con-registros'}">No se puede eliminar el periodo porque tiene ideas o proyectos asociados. Puedes cerrarlo.</c:when>
            <c:when test="${param.error == 'otro-periodo-activo'}">Ya hay un periodo activo. Ciérralo antes de activar otro.</c:when>
            <c:when test="${param.error == 'idea-no-editable'}">Esa idea ya no se puede modificar: solo se modifican las ideas propias pendientes o rechazadas.</c:when>
            <c:when test="${param.error == 'idea-no-disponible'}">Esa idea no está disponible para ti.</c:when>
            <c:when test="${param.error == 'observacion-requerida'}">Escribe una observación: es obligatoria al aprobar o rechazar.</c:when>
            <c:when test="${param.error == 'no-habilitado'}">Todavía no cumples los requisitos para tomar una idea. Revisa tu habilitación.</c:when>
            <c:when test="${param.error == 'sin-periodo-activo'}">No hay un periodo activo: el banco de ideas está cerrado.</c:when>
            <c:when test="${param.error == 'banco-cerrado'}">El banco de ideas ya cerró para este periodo.</c:when>
            <c:when test="${param.error == 'proyecto-vigente'}">Ya tienes un proyecto vigente. Un estudiante solo puede tener uno a la vez.</c:when>
            <c:when test="${param.error == 'modalidad-requerida'}">Escoge la modalidad de tu proyecto.</c:when>
            <c:when test="${param.error == 'pago-no-aplica'}">En tu plan de estudios el pago lo cubre la matrícula del Seminario de Grado: no necesitas subir un recibo.</c:when>
            <c:when test="${param.error == 'fase-no-permite'}">El recibo de pago se sube en la fase 1 (o en la 2, si te agregaron después al proyecto).</c:when>
            <c:when test="${param.error == 'pago-vencido'}">Ya pasó la fecha límite de pago de este periodo.</c:when>
            <c:when test="${param.error == 'archivo-requerido'}">Escoge el archivo que vas a subir.</c:when>
            <c:when test="${param.error == 'archivo-grande'}">El archivo pesa más de 15 MB.</c:when>
            <c:when test="${param.error == 'archivo-invalido'}">El archivo debe ser un PDF.</c:when>
            <c:when test="${param.error == 'pago-aprobado'}">El comité ya aprobó tu pago: no necesitas subir otro recibo.</c:when>
            <c:when test="${param.error == 'pago-ya-revisado'}">Ese recibo ya se revisó o ya no es el último que subió el estudiante.</c:when>
            <c:when test="${param.error == 'director-invalido'}">Escoge un director: debe ser un docente activo con el rol Director.</c:when>
            <c:when test="${param.error == 'evaluador-invalido'}">El evaluador debe ser un docente activo con el rol Evaluador.</c:when>
            <c:when test="${param.error == 'director-evaluador'}">Un docente no puede evaluar el proyecto que dirige. Escoge otro evaluador.</c:when>
            <c:when test="${param.error == 'seminario-sin-124'}">La modalidad Seminario no usa el F-DC-124.</c:when>
            <c:when test="${param.error == 'fase-no-permite-propuesta'}">La propuesta (FDC-124) se sube y se envía en la fase 2.</c:when>
            <c:when test="${param.error == 'archivo-no-word'}">El FDC-124 debe ser un documento de Word (.doc o .docx).</c:when>
            <c:when test="${param.error == 'sin-director'}">Tu proyecto todavía no tiene director.</c:when>
            <c:when test="${param.error == 'propuesta-requerida'}">Sube el FDC-124 antes de enviarlo a tu director.</c:when>
            <c:when test="${param.error == 'propuesta-devuelta'}">Tu director devolvió la última versión: sube una versión corregida antes de enviarla otra vez.</c:when>
            <c:when test="${param.error == 'propuesta-no-revisable'}">Esa propuesta no está esperando tu revisión: ya la revisaste o el proyecto no está en la fase 3.</c:when>
            <c:when test="${param.error == 'sin-evaluador'}">El comité todavía no asigna el evaluador: puedes devolver la propuesta, pero no enviarla.</c:when>
            <c:when test="${param.error == 'turnitin-requerido'}">Para aprobar la propuesta, sube el reporte de Turnitin en PDF.</c:when>
            <c:when test="${param.error == 'integrantes-cerrados'}">Los integrantes solo se cambian en las fases 1 y 2: al enviar la propuesta al director, el grupo queda cerrado.</c:when>
            <c:when test="${param.error == 'integrante-no-existe'}">No hay un estudiante registrado y activo con ese correo. Tu compañero debe crear su cuenta primero.</c:when>
            <c:when test="${param.error == 'integrante-con-proyecto'}">Ese estudiante ya tiene un proyecto vigente: solo se puede tener uno a la vez.</c:when>
            <c:when test="${param.error == 'integrante-otro-nivel'}">Ese estudiante es de otro nivel (tecnológico o universitario) que el proyecto.</c:when>
            <c:when test="${param.error == 'integrante-no-habilitado'}">Hay un integrante que no está habilitado (créditos o Metodología). Debe revisar su habilitación.</c:when>
            <c:when test="${param.error == 'integrantes-completos'}">El proyecto ya tiene el máximo de integrantes de su modalidad.</c:when>
            <c:when test="${param.error == 'demasiados-integrantes'}">El proyecto tiene más integrantes de los que permite su modalidad.</c:when>
            <c:when test="${param.error == 'pagos-pendientes'}">Todos los integrantes deben tener el pago aprobado por el comité antes de enviar la propuesta.</c:when>
            <c:when test="${param.error == 'codirector-invalido'}">Los codirectores deben ser docentes activos con el rol Director, distintos entre sí, del director y del evaluador.</c:when>
            <c:when test="${param.error == 'modalidad-fuera-de-tiempo'}">La modalidad solo se cambia antes de que se apruebe el FDC-124 (fases 1 a 3).</c:when>
            <c:when test="${param.error == 'modalidad-pendiente'}">Ya hay una solicitud de cambio de modalidad esperando la decisión del comité.</c:when>
            <c:when test="${param.error == 'modalidad-invalida'}">Escoge una modalidad distinta a la actual.</c:when>
            <c:when test="${param.error == 'modalidad-integrantes'}">Esa modalidad no admite la cantidad de integrantes del proyecto.</c:when>
            <c:when test="${param.error == 'motivo-requerido'}">Escribe el motivo del cambio de modalidad.</c:when>
            <c:when test="${param.error == 'modalidad-ya-decidida'}">Esa solicitud ya fue decidida.</c:when>
            <c:when test="${param.error == 'exoneracion-solo-tecnologia'}">La exoneración por Saber TyT es solo para el nivel tecnológico.</c:when>
            <c:when test="${param.error == 'exoneracion-informe-entregado'}">Ya se entregó el informe final: la exoneración se pide antes.</c:when>
            <c:when test="${param.error == 'exoneracion-ya-decidida'}">Ya tienes una exoneración aprobada o renunciaste a ella (no tiene vuelta atrás).</c:when>
            <c:when test="${param.error == 'exoneracion-pendiente'}">Ya tienes una solicitud de exoneración esperando la verificación del comité.</c:when>
            <c:when test="${param.error == 'puntaje-invalido'}">El puntaje debe ser un número entero entre 120 y 300.</c:when>
            <c:when test="${param.error == 'sin-exoneracion'}">No tienes una exoneración aprobada a la cual renunciar.</c:when>
            <c:when test="${param.error == 'pqr-incompleta'}">Escoge el tipo y escribe tu PQR.</c:when>
            <c:when test="${param.error == 'respuesta-requerida'}">Escribe la respuesta: es obligatoria.</c:when>
            <c:when test="${param.error == 'proyecto-cerrado'}">El proyecto está finalizado o cancelado: ya no se modifica.</c:when>
            <c:when test="${param.error == 'sesion-duplicada'}">Ya hay una sesión del comité ese día en este periodo.</c:when>
            <c:when test="${param.error == 'sesion-invalida'}">Revisa la fecha y la hora de la sesión.</c:when>
            <c:otherwise>Ocurrió un error. Inténtalo de nuevo.</c:otherwise>
        </c:choose>
    </div>
</c:if>
